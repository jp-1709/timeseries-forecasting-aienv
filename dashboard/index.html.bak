<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Steel HRC Price Dashboard</title>
    <link rel="stylesheet" href="/static/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>
    <div class="container">
        <!-- Header -->
        <header class="header">
            <h1>Steel HRC Price Dashboard</h1>
            <p class="subtitle">Real-time market data & AI-powered predictions</p>
        </header>

        <!-- Main Content -->
        <div class="dashboard-grid">
            <!-- Left Section: Current Price & Historical Trends -->
            <div class="section left-section">
                <!-- Current Price Card -->
                <div class="card price-card">
                    <h2 class="card-title">Current Market Price</h2>
                    <div class="price-display">
                        <div class="price-value" id="currentPrice">--</div>
                        <div class="price-change" id="priceChange">
                            <span class="change-value">--</span>
                        </div>
                    </div>
                    <div class="price-meta">
                        <span id="lastUpdated">Last updated: --</span>
                    </div>
                </div>

                <!-- Historical Trend Chart -->
                <div class="card chart-card">
                    <div class="card-header">
                        <h2 class="card-title">Historical Trends</h2>
                        <div class="time-range-buttons">
                            <button class="time-btn" data-days="5">5D</button>
                            <button class="time-btn active" data-days="30">1M</button>
                            <button class="time-btn" data-days="90">3M</button>
                            <button class="time-btn" data-days="180">6M</button>
                        </div>
                    </div>
                    <div class="chart-container">
                        <canvas id="historicalChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Right Section: Price Prediction & Forecast Trends -->
            <div class="section right-section">
                <!-- Prediction Cards -->
                <div class="predictions-grid">
                    <div class="card prediction-card">
                        <h3 class="prediction-label">1 Day Forecast</h3>
                        <div class="prediction-value" id="pred1d">--</div>
                        <div class="prediction-change" id="change1d">--</div>
                    </div>
                    <div class="card prediction-card">
                        <h3 class="prediction-label">7 Days Forecast</h3>
                        <div class="prediction-value" id="pred7d">--</div>
                        <div class="prediction-change" id="change7d">--</div>
                    </div>
                    <div class="card prediction-card">
                        <h3 class="prediction-label">30 Days Forecast</h3>
                        <div class="prediction-value" id="pred30d">--</div>
                        <div class="prediction-change" id="change30d">--</div>
                    </div>
                    <div class="card prediction-card">
                        <h3 class="prediction-label">60 Days Forecast</h3>
                        <div class="prediction-value" id="pred60d">--</div>
                        <div class="prediction-change" id="change60d">--</div>
                    </div>
                </div>

                <!-- Forecast Trend Chart -->
                <div class="card chart-card">
                    <div class="card-header">
                        <h2 class="card-title">Price Forecast</h2>
                        <div class="legend">
                            <span class="legend-item">
                                <span class="legend-line historical"></span>
                                Historical
                            </span>
                            <span class="legend-item">
                                <span class="legend-line forecast"></span>
                                Forecast
                            </span>
                        </div>
                    </div>
                    <div class="chart-container">
                        <canvas id="forecastChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Loading Overlay -->
        <div class="loading-overlay" id="loadingOverlay">
            <div class="spinner"></div>
            <p>Loading data...</p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="/static/app.js"></script>
</body>

</html>